@page "/olvide-password"
@inject IAuthHttpProxy AuthProxy

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-titulo">Gnosis</h1>
        <p class="auth-subtitulo">Escribe tu correo y te mandamos un enlace para elegir una contraseña nueva.</p>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="text-success small">@mensaje</p>
        }

        @if (!enviado)
        {
            <div class="auth-campo">
                <label>Correo</label>
                <input type="email" class="form-control" @bind="email" @onkeyup="HandleKeyUp" disabled="@cargando" />
            </div>

            <button class="btn btn-primary auth-btn" @onclick="EnviarAsync" disabled="@cargando">
                @(cargando ? "Enviando..." : "Enviar enlace")
            </button>
        }

        <p class="auth-link">
            <a href="/login">Volver a iniciar sesión</a>
        </p>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string? mensaje;
    private bool cargando;
    private bool enviado;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await EnviarAsync();
    }

    private async Task EnviarAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
            return;

        cargando = true;
        var resultado = await AuthProxy.OlvidePasswordAsync(email.Trim());
        cargando = false;
        enviado = true;

        // La API siempre responde el mismo mensaje genérico, exista o no la cuenta
        // (para no revelar qué correos están registrados).
        mensaje = resultado.Mensaje ?? "Si el correo existe, se envió un enlace para restablecer la contraseña.";
    }
}
