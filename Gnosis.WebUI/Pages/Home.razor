@page "/"
@inject Gnosis.WebUI.TemporizadorPomodoro Pomodoro
@inject Gnosis.WebUI.ITareaHttpProxy TareaProxy
@inject Gnosis.WebUI.EstadoFondoActual EstadoFondo
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using Gnosis.Business.Models
@using Gnosis.WebUI.Components
@implements IDisposable

@if (tareas == null)
{
    <div style="background: #1e1e1e; color: #ffffff; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: sans-serif;">
        <span style="font-size: 1.1rem; letter-spacing: 1px; opacity: 0.8;">Iniciando Gnosis...</span>
    </div>
}
else
{
    <!-- FONDO -->
    <div class="video-bg-wrapper" aria-hidden="true">
        <iframe id="ytBackground"
                src="@ObtenerUrlEmbed()"
                title="Background ambience"
                frameborder="0"
                allow="autoplay; encrypted-media"
                referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
        <div class="video-bg-overlay"></div>
    </div>

    <!-- Iframe invisible para el audio (lo controla la YT API via JS) -->
    <div style="position:fixed; width:1px; height:1px; opacity:0; pointer-events:none; z-index:-1;">
        <div id="yt-audio-player"></div>
    </div>

    <SelectorFondos />

    <!-- PANEL POMODORO -->
    <div id="panel-pomodoro"
         class="panel-flotante @(pomodoroMinimizado ? "panel-minimizado borde-" + BordeMinimizado(pomodoroX) : "")"
         style="@EstiloPanelMinimizado(pomodoroMinimizado, pomodoroX, pomodoroY)">

        <div class="panel-header" @onmousedown="OnMouseDownPomodoro">
            <span class="panel-titulo">Pomodoro</span>
            <button class="btn-minimizar-panel" @onclick="TogglePomodoro" @onclick:stopPropagation="true">
                @if (pomodoroMinimizado)
                {
                    <span class="mini-modo">@ModoCorto()</span>
                    <span class="mini-tiempo">@Pomodoro?.TiempoFormateado</span>
                }
                else
                {
                    <span>&#x25BE;</span>
                }
            </button>
        </div>

        @if (!pomodoroMinimizado)
        {
            <div class="panel-contenido">
                <div class="timer-main-row">
                    <div class="timer-clock-compact">@Pomodoro?.TiempoFormateado</div>
                    <div class="timer-actions-right">
                        @if (Pomodoro?.NombreEstadoActual == "Pausado" || Pomodoro?.NombreEstadoActual == "Detenido")
                        {
                            <button class="btn-timer-main" @onclick="Pomodoro.Iniciar">Start</button>
                        }
                        else
                        {
                            <button class="btn-timer-main" @onclick="Pomodoro!.Pausar">Pause</button>
                        }
                        <button class="btn-timer-icon" @onclick="Pomodoro!.Detener" title="Reiniciar">&#x21BB;</button>
                    </div>
                </div>

                <div class="timer-footer-row">
                    <div class="timer-modes">
                        <button class="mode-link @(Pomodoro?.ModoActual.ToString() == "Enfoque" ? "active" : "")"
                                @onclick='() => SeleccionarModo(Gnosis.WebUI.ModoPomodoro.Enfoque)'>
                            Pomodoro
                        </button>
                        <button class="mode-link @(Pomodoro?.ModoActual.ToString() == "DescansoCorto" ? "active" : "")"
                                @onclick='() => SeleccionarModo(Gnosis.WebUI.ModoPomodoro.DescansoCorto)'>
                            Short Break
                        </button>
                        <button class="mode-link @(Pomodoro?.ModoActual.ToString() == "DescansoLargo" ? "active" : "")"
                                @onclick='() => SeleccionarModo(Gnosis.WebUI.ModoPomodoro.DescansoLargo)'>
                            Long Break
                        </button>
                    </div>
                    <button class="btn-timer-icon-settings @(mostrarConfiguracion ? "panel-open" : "")"
                            @onclick="ToggleConfiguracion" title="Configuracion">
                        &#x2699;
                    </button>
                </div>

                <div class="timer-settings-panel @(mostrarConfiguracion ? "show" : "")">
                    <div class="setting-field">
                        <label>Pomodoro</label>
                        <input type="number" min="1" max="60" @bind-value="TiempoPomodoro" />
                    </div>
                    <div class="setting-field">
                        <label>Short</label>
                        <input type="number" min="1" max="30" @bind-value="TiempoDescansoCorto" />
                    </div>
                    <div class="setting-field">
                        <label>Long</label>
                        <input type="number" min="1" max="60" @bind-value="TiempoDescansoLargo" />
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- PANEL TODO -->
    <div id="panel-todo"
         class="panel-flotante @(todoMinimizado ? "panel-minimizado borde-" + BordeMinimizado(todoX) : "")"
         style="@EstiloPanelMinimizado(todoMinimizado, todoX, todoY)">

        <div class="panel-header" @onmousedown="OnMouseDownTodo">
            <span class="panel-titulo">Lista To-Do</span>
            <button class="btn-minimizar-panel" @onclick="ToggleTodo" @onclick:stopPropagation="true">
                @if (todoMinimizado)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="15" y2="18" />
                    </svg>
                }
                else
                {
                    <span>&#x25BE;</span>
                }
            </button>
        </div>

        @if (!todoMinimizado)
        {
            <div class="panel-contenido">
                @if (!tareas.Any())
                {
                    <p class="text-white-50 small">No hay tareas pendientes.</p>
                }
                else
                {
                    <div class="todo-list mb-3">
                        @foreach (var tarea in tareas)
                        {
                            <div class="p-2 mb-2 rounded bg-white bg-opacity-10 border border-light border-opacity-10 position-relative todo-item-container">
                                <div class="d-flex align-items-center gap-2 group-actions">
                                    <input type="checkbox" checked="@tarea.IsCompletada" @onchange="() => CambiarEstadoTarea(tarea)" class="form-check-input m-0" />
                                    <span class="flex-grow-1 @(tarea.IsCompletada ? "text-decoration-line-through text-white-50" : "text-white")">@tarea.Titulo</span>
                                    <button class="btn-delete-task" @onclick="() => EliminarTareaPadre(tarea)" title="Eliminar">&#x00D7;</button>
                                </div>

                                @if (tarea.Subtareas != null && tarea.Subtareas.Any())
                                {
                                    <div class="mt-2 ps-4 border-start border-light border-opacity-25">
                                        @foreach (var subtarea in tarea.Subtareas)
                                        {
                                            <div class="d-flex align-items-center gap-2 py-1 group-actions">
                                                <input type="checkbox" checked="@subtarea.IsCompletada" @onchange="() => CambiarEstadoTarea(subtarea)" class="form-check-input m-0" />
                                                <span class="small flex-grow-1 @(subtarea.IsCompletada ? "text-decoration-line-through text-white-50" : "text-white-50")">@subtarea.Titulo</span>
                                                <button class="btn-delete-task" @onclick="() => EliminarSubtarea(tarea, subtarea)" title="Eliminar">&#x00D7;</button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="input-group input-group-sm mt-2 ps-4">
                                    <input type="text" class="form-control bg-dark bg-opacity-25 text-white border-0"
                                           placeholder="Anadir subtarea..."
                                           value="@ObtenerTextoSubtarea(tarea.Id)"
                                           @oninput="@(e => ActualizarTextoSubtarea(tarea.Id, e.Value?.ToString()))"
                                           @onkeyup="@(e => VerificarIntroSubtarea(e, tarea))" />
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="input-group input-group-sm">
                    <input type="text" class="form-control bg-white bg-opacity-10 text-white border-0"
                           placeholder="Nuevo objetivo..."
                           @bind="nuevaTareaTitulo"
                           @onkeyup="HandleKeyUp" />
                    <button class="btn btn-primary" @onclick="CrearNuevaTarea">Agregar</button>
                </div>
            </div>
        }
    </div>

    <!-- PANEL REPRODUCTOR DE AUDIO -->
    <div id="panel-audio"
         class="panel-flotante @(audioMinimizado ? "panel-minimizado borde-" + BordeMinimizado(audioX) : "")"
         style="@EstiloPanelMinimizado(audioMinimizado, audioX, audioY)">

        <div class="panel-header" @onmousedown="OnMouseDownAudio">
            <span class="panel-titulo">Musica</span>
            <button class="btn-minimizar-panel" @onclick="ToggleAudio" @onclick:stopPropagation="true">
                @if (audioMinimizado)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                    </svg>
                }
                else
                {
                    <span>&#x25BE;</span>
                }
            </button>
        </div>

        @if (!audioMinimizado)
        {
            <div class="panel-contenido">
                <!-- INPUT URL -->
                <div class="audio-url-row">
                    <input type="text"
                           class="audio-url-input"
                           placeholder="Pega la URL de YouTube..."
                           @bind="audioUrl"
                           @onkeyup="HandleAudioKeyUp" />
                    <button class="audio-btn-cargar" @onclick="CargarAudio" title="Cargar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <polyline points="9 10 4 15 9 20" />
                            <path d="M20 4v7a4 4 0 0 1-4 4H4" />
                        </svg>
                    </button>
                </div>

                <!-- CONTROLES -->
                <div class="audio-controles">
                    <button class="audio-btn-play" @onclick="TogglePlayPause" disabled="@(!audioCargado)">
                        @if (audioReproduciendo)
                        {
                            <!-- Pause -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                                 viewBox="0 0 24 24">
                                <rect x="6" y="4" width="4" height="16" />
                                <rect x="14" y="4" width="4" height="16" />
                            </svg>
                        }
                        else
                        {
                            <!-- Play -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                                 viewBox="0 0 24 24">
                                <polygon points="5 3 19 12 5 21 5 3" />
                            </svg>
                        }
                    </button>

                    <!-- Volumen -->
                    <div class="audio-volumen-row">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                            @if (audioVolumen > 0)
                            {
                                <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                            }
                            @if (audioVolumen > 50)
                            {
                                <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                            }
                        </svg>
                        <input type="range" min="0" max="100" step="1"
                               class="audio-volumen-slider"
                               value="@audioVolumen"
                               @oninput="CambiarVolumen" />
                        <span class="audio-volumen-label">@audioVolumen</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(audioError))
                {
                    <p class="audio-error">@audioError</p>
                }
            </div>
        }
    </div>
}

@code {
    private DotNetObjectReference<Home>? _dotnetRef;

    // ── Estado paneles ───────────────────────────────────────────
    private bool pomodoroMinimizado = false;
    private bool todoMinimizado = false;
    private bool audioMinimizado = false;

    // ── Posiciones ───────────────────────────────────────────────
    private double pomodoroX = 40;
    private double pomodoroY = 120;
    private double todoX = 460;
    private double todoY = 120;
    private double audioX = 40;
    private double audioY = 420;

    // ── Audio ────────────────────────────────────────────────────
    private string audioUrl = string.Empty;
    private bool audioCargado = false;
    private bool audioReproduciendo = false;
    private int audioVolumen = 80;
    private string audioError = string.Empty;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _dotnetRef = DotNetObjectReference.Create(this);
    }

    [JSInvokable]
    public void ActualizarPosicion(string panelId, double x, double y)
    {
        if (panelId == "panel-pomodoro") { pomodoroX = x; pomodoroY = y; }
        else if (panelId == "panel-todo") { todoX = x; todoY = y; }
        else if (panelId == "panel-audio") { audioX = x; audioY = y; }
    }

    private async Task OnMouseDownPomodoro(MouseEventArgs e)
    {
        var offX = pomodoroMinimizado ? 0 : e.ClientX - pomodoroX;
        var offY = e.ClientY - pomodoroY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-pomodoro", _dotnetRef,
                                  offX, offY, pomodoroMinimizado);
    }

    private async Task OnMouseDownTodo(MouseEventArgs e)
    {
        var offX = todoMinimizado ? 0 : e.ClientX - todoX;
        var offY = e.ClientY - todoY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-todo", _dotnetRef,
                                  offX, offY, todoMinimizado);
    }

    private async Task OnMouseDownAudio(MouseEventArgs e)
    {
        var offX = audioMinimizado ? 0 : e.ClientX - audioX;
        var offY = e.ClientY - audioY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-audio", _dotnetRef,
                                  offX, offY, audioMinimizado);
    }

    // ── Audio lógica ─────────────────────────────────────────────
    private async Task CargarAudio()
    {
        audioError = string.Empty;
        var videoId = ExtraerVideoId(audioUrl);
        if (string.IsNullOrEmpty(videoId))
        {
            audioError = "URL no valida. Pega un enlace de YouTube.";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("gnosis.reproductorAudio.cargar", videoId);
            audioCargado = true;
            audioReproduciendo = true;
        }
        catch (Exception ex)
        {
            audioError = $"Error al cargar: {ex.Message}";
        }
    }

    private async Task TogglePlayPause()
    {
        if (!audioCargado) return;
        if (audioReproduciendo)
        {
            await JS.InvokeVoidAsync("gnosis.reproductorAudio.pause");
            audioReproduciendo = false;
        }
        else
        {
            await JS.InvokeVoidAsync("gnosis.reproductorAudio.play");
            audioReproduciendo = true;
        }
    }

    private async Task CambiarVolumen(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var vol))
        {
            audioVolumen = vol;
            await JS.InvokeVoidAsync("gnosis.reproductorAudio.setVolume", vol);
        }
    }

    private async Task HandleAudioKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CargarAudio();
    }

    // Extrae el ID del video de cualquier formato de URL de YouTube
    private static string? ExtraerVideoId(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        try
        {
            var uri = new Uri(url.Trim());

            if (uri.Host.Contains("youtu.be"))
                return uri.AbsolutePath.TrimStart('/').Split('?')[0];

            var query = uri.Query.TrimStart('?');
            foreach (var par in query.Split('&'))
            {
                var partes = par.Split('=');
                if (partes.Length == 2 && partes[0] == "v" && partes[1].Length > 0)
                    return partes[1];
            }
        }
        catch { }
        return null;
    }

    // ── Helpers ──────────────────────────────────────────────────
    private string BordeMinimizado(double x) => x < 700 ? "izquierdo" : "derecho";

    private string EstiloPanelMinimizado(bool minimizado, double x, double y)
    {
        if (minimizado) return $"top: {y}px;";
        return $"left: {x}px; top: {y}px;";
    }

    private string ModoCorto() => Pomodoro?.ModoActual.ToString() switch
    {
        "Enfoque" => "P",
        "DescansoCorto" => "S",
        "DescansoLargo" => "L",
        _ => "P"
    };

    private void TogglePomodoro() => pomodoroMinimizado = !pomodoroMinimizado;
    private void ToggleTodo() => todoMinimizado = !todoMinimizado;
    private void ToggleAudio() => audioMinimizado = !audioMinimizado;

    // ── Lógica existente ─────────────────────────────────────────
    private List<TareaModel>? tareas;
    private string nuevaTareaTitulo = string.Empty;
    private Dictionary<Guid, string> NuevosTitulosSubtareas { get; set; } = new();
    private bool mostrarConfiguracion = false;

    private int TiempoPomodoro
    {
        get => Pomodoro != null ? Pomodoro.DuracionEnfoque : 25;
        set { if (Pomodoro == null) return; Pomodoro.DuracionEnfoque = value; if (Pomodoro.ModoActual == Gnosis.WebUI.ModoPomodoro.Enfoque) Pomodoro.RestablecerTiempoPorModo(); }
    }
    private int TiempoDescansoCorto
    {
        get => Pomodoro != null ? Pomodoro.DuracionDescansoCorto : 5;
        set { if (Pomodoro == null) return; Pomodoro.DuracionDescansoCorto = value; if (Pomodoro.ModoActual == Gnosis.WebUI.ModoPomodoro.DescansoCorto) Pomodoro.RestablecerTiempoPorModo(); }
    }
    private int TiempoDescansoLargo
    {
        get => Pomodoro != null ? Pomodoro.DuracionDescansoLargo : 15;
        set { if (Pomodoro == null) return; Pomodoro.DuracionDescansoLargo = value; if (Pomodoro.ModoActual == Gnosis.WebUI.ModoPomodoro.DescansoLargo) Pomodoro.RestablecerTiempoPorModo(); }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Pomodoro != null) { Pomodoro.OnTick -= ActualizarPantalla; Pomodoro.OnTick += ActualizarPantalla; }
            EstadoFondo.OnCambio -= ActualizarPantalla;
            EstadoFondo.OnCambio += ActualizarPantalla;
            await CargarTareas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Gnosis Error] {ex.Message}");
            tareas = new List<TareaModel>();
        }
    }

    private string ObtenerUrlEmbed()
    {
        var videoId = EstadoFondo.FondoActivo.YoutubeVideoId;
        var origen = NavManager.BaseUri.TrimEnd('/');
        return $"https://www.youtube.com/embed/{videoId}?autoplay=1&mute=1&loop=1&playlist={videoId}&controls=0&showinfo=0&rel=0&iv_load_policy=3&disablekb=1&modestbranding=1&enablejsapi=1&playsinline=1&origin={origen}";
    }

    private void ToggleConfiguracion() => mostrarConfiguracion = !mostrarConfiguracion;

    private async Task CargarTareas()
    {
        try { tareas = TareaProxy != null ? (await TareaProxy.ObtenerTodasAsync())?.ToList() ?? new() : new(); }
        catch (Exception ex) { Console.WriteLine($"Error al cargar tareas: {ex.Message}"); tareas = new(); }

        NuevosTitulosSubtareas = new();
        if (tareas != null)
            foreach (var t in tareas)
                if (t != null && !NuevosTitulosSubtareas.ContainsKey(t.Id))
                    NuevosTitulosSubtareas[t.Id] = string.Empty;
    }

    private string ObtenerTextoSubtarea(Guid id) => NuevosTitulosSubtareas.TryGetValue(id, out var texto) ? texto : string.Empty;
    private void ActualizarTextoSubtarea(Guid id, string? valor) => NuevosTitulosSubtareas[id] = valor ?? string.Empty;

    private async Task CrearNuevaTarea()
    {
        if (string.IsNullOrWhiteSpace(nuevaTareaTitulo)) return;
        try
        {
            var nueva = new TareaModel { Id = Guid.NewGuid(), Titulo = nuevaTareaTitulo, FechaCreacion = DateTime.UtcNow, Subtareas = new() };
            tareas ??= new();
            tareas.Add(nueva);
            NuevosTitulosSubtareas[nueva.Id] = string.Empty;
            nuevaTareaTitulo = string.Empty;
            await InvokeAsync(StateHasChanged);
            if (TareaProxy != null) await TareaProxy.CrearTareaAsync(nueva);
        }
        catch (Exception ex) { Console.WriteLine($"[Gnosis] Error al crear tarea: {ex.Message}"); }
    }

    private async Task AgregarSubtarea(TareaModel padre)
    {
        if (!NuevosTitulosSubtareas.TryGetValue(padre.Id, out var sub) || string.IsNullOrWhiteSpace(sub)) return;
        try
        {
            var nuevaSub = new TareaModel { Id = Guid.NewGuid(), Titulo = sub, TareaPadreId = padre.Id, Subtareas = new() };
            padre.Subtareas ??= new();
            padre.Subtareas.Add(nuevaSub);
            NuevosTitulosSubtareas[padre.Id] = string.Empty;
            await InvokeAsync(StateHasChanged);
            if (TareaProxy != null) await TareaProxy.CrearTareaAsync(nuevaSub);
        }
        catch (Exception ex) { Console.WriteLine($"[Gnosis] Error al agregar subtarea: {ex.Message}"); }
    }

    private async Task CambiarEstadoTarea(TareaModel tarea)
    {
        tarea.IsCompletada = !tarea.IsCompletada;
        if (TareaProxy != null) await TareaProxy.ActualizarEstadoTareaAsync(tarea.Id, tarea.IsCompletada);
    }

    private async Task EliminarTareaPadre(TareaModel padre)
    {
        if (tareas == null) return;
        tareas.Remove(padre);
        if (NuevosTitulosSubtareas.ContainsKey(padre.Id)) NuevosTitulosSubtareas.Remove(padre.Id);
        if (TareaProxy != null)
            try { await TareaProxy.EliminarTareaAsync(padre.Id); }
            catch (Exception ex) { Console.WriteLine($"Error al eliminar: {ex.Message}"); }
    }

    private async Task EliminarSubtarea(TareaModel padre, TareaModel subtarea)
    {
        padre.Subtareas?.Remove(subtarea);
        if (TareaProxy != null)
            try { await TareaProxy.EliminarTareaAsync(subtarea.Id); }
            catch (Exception ex) { Console.WriteLine($"Error al eliminar subtarea: {ex.Message}"); }
    }

    private async Task VerificarIntroSubtarea(KeyboardEventArgs e, TareaModel padre) { if (e.Key == "Enter") await AgregarSubtarea(padre); }
    private async Task HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await CrearNuevaTarea(); }
    private void ActualizarPantalla() => InvokeAsync(StateHasChanged);
    private void SeleccionarModo(Gnosis.WebUI.ModoPomodoro modo) { Pomodoro?.CambiarModo(modo); StateHasChanged(); }

    public void Dispose()
    {
        if (Pomodoro != null) Pomodoro.OnTick -= ActualizarPantalla;
        EstadoFondo.OnCambio -= ActualizarPantalla;
        _dotnetRef?.Dispose();
    }
}