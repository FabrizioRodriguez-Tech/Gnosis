@page "/"
@attribute [Authorize]
@* REFACTORIZACIÓN: Extract Class aplicado sobre God Class *@
@inject Gnosis.WebUI.TemporizadorPomodoro Pomodoro
@inject Gnosis.WebUI.ITareaHttpProxy TareaProxy
@inject EstadoFondoActual EstadoFondo
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject Gnosis.WebUI.Services.NotificacionService Notificaciones
@inject Gnosis.WebUI.ISesionEnfoqueHttpProxy SesionProxy
@inject Gnosis.WebUI.services.TokenStorageService TokenStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject Gnosis.WebUI.IBloqueTiempoHttpProxy BloqueProxy
@using Gnosis.Business.Models
@using Gnosis.WebUI.Components
@using Gnosis.WebUI.Services
@implements IDisposable

@if (tareas == null)
{
    <div style="background: #1e1e1e; color: #ffffff; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: sans-serif;">
        <span style="font-size: 1.1rem; letter-spacing: 1px; opacity: 0.8;">Iniciando Gnosis...</span>
    </div>
}
else
{
    <div class="video-bg-wrapper" aria-hidden="true">
        <iframe id="ytBackground"
                src="@ObtenerUrlEmbed()"
                title="Background ambience"
                frameborder="0"
                allow="autoplay; encrypted-media"
                referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
        <div class="video-bg-overlay @(ocultandoTransicionFondo ? "video-bg-overlay-transicion" : "")"></div>
    </div>

    <div style="position:fixed; width:1px; height:1px; opacity:0; pointer-events:none; z-index:-1;">
        <div id="yt-audio-player"></div>
    </div>

    <SelectorFondos />

    <div style="position:fixed; top:14px; right:14px; z-index:50; display:flex; align-items:center; gap:10px; background:rgba(30,37,48,0.85); backdrop-filter: blur(10px); padding:6px 10px; border-radius:10px; border:1px solid rgba(255,255,255,0.12);">
        <AuthorizeView>
            <Authorized>
                <span style="color:#fff; font-size:0.78rem; opacity:0.85;">@context.User.FindFirst("email")?.Value</span>
                <button class="btn btn-sm btn-outline-light" style="font-size:0.75rem; padding:2px 8px;" @onclick="CerrarSesionAsync">Cerrar sesión</button>
            </Authorized>
        </AuthorizeView>
    </div>

    <!-- PANEL POMODORO -->
    <div id="panel-pomodoro"
         class="panel-flotante @(pomodoroMinimizado ? "panel-minimizado borde-" + BordeMinimizado(pomodoroX) : "")"
         style="@EstiloPanel(pomodoroMinimizado, pomodoroX, pomodoroY)">

        <div class="panel-header" @onmousedown="OnMouseDownPomodoro">
            <span class="panel-titulo">Pomodoro</span>
            <button class="btn-minimizar-panel" @onclick="TogglePomodoro" @onclick:stopPropagation="true">
                @if (pomodoroMinimizado)
                {
                    <span class="mini-modo">@ModoCorto()</span>
                    <span class="mini-tiempo">@Pomodoro?.TiempoFormateado</span>
                }
                else
                {
                    <span>&#x25BE;</span>
                }
            </button>
        </div>

        @if (!pomodoroMinimizado)
        {
            <div class="panel-contenido">
                <div class="timer-main-row">
                    <div class="timer-clock-compact">@Pomodoro?.TiempoFormateado</div>
                    <div class="timer-actions-right">
                        @if (Pomodoro?.NombreEstadoActual == "Pausado" || Pomodoro?.NombreEstadoActual == "Detenido")
                        {
                            <button class="btn-timer-main" @onclick="() => Pomodoro?.Iniciar()">Start</button>
                        }
                        else
                        {
                            <button class="btn-timer-main" @onclick="() => Pomodoro?.Pausar()">Pause</button>
                        }
                        <button class="btn-timer-icon" @onclick="() => Pomodoro?.Detener()" title="Reiniciar">&#x21BB;</button>
                    </div>
                </div>

                <div class="timer-footer-row">
                    <div class="timer-modes">
                        <button class="mode-link @(Pomodoro?.ModoActual.ToString() == "Enfoque" ? "active" : "")"
                                @onclick='() => SeleccionarModo(Gnosis.WebUI.ModoPomodoro.Enfoque)'>
                            Pomodoro
                        </button>
                        <button class="mode-link @(Pomodoro?.ModoActual.ToString() == "DescansoCorto" ? "active" : "")"
                                @onclick='() => SeleccionarModo(Gnosis.WebUI.ModoPomodoro.DescansoCorto)'>
                            Short Break
                        </button>
                        <button class="mode-link @(Pomodoro?.ModoActual.ToString() == "DescansoLargo" ? "active" : "")"
                                @onclick='() => SeleccionarModo(Gnosis.WebUI.ModoPomodoro.DescansoLargo)'>
                            Long Break
                        </button>
                    </div>
                    <button class="btn-timer-icon-settings @(mostrarConfiguracion ? "panel-open" : "")"
                            @onclick="ToggleConfiguracion" title="Configuracion">
                        &#x2699;
                    </button>
                </div>

                <div class="timer-settings-panel @(mostrarConfiguracion ? "show" : "")">
                    <div class="setting-field">
                        <label>Pomodoro</label>
                        <input type="number" min="1" max="60" @bind-value="TiempoPomodoro" />
                    </div>
                    <div class="setting-field">
                        <label>Short</label>
                        <input type="number" min="1" max="60" @bind-value="TiempoDescansoCorto" />
                    </div>
                    <div class="setting-field">
                        <label>Long</label>
                        <input type="number" min="1" max="60" @bind-value="TiempoDescansoLargo" />
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- PANEL TODO -->
    <div id="panel-todo"
         class="panel-flotante @(todoMinimizado ? "panel-minimizado borde-" + BordeMinimizado(todoX) : "")"
         style="@EstiloPanel(todoMinimizado, todoX, todoY)">

        <div class="panel-header" @onmousedown="OnMouseDownTodo">
            <span class="panel-titulo">Lista To-Do</span>
            <button class="btn-minimizar-panel" @onclick="ToggleTodo" @onclick:stopPropagation="true">
                @if (todoMinimizado)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="15" y2="18" />
                    </svg>
                }
                else
                {
                    <span>&#x25BE;</span>
                }
            </button>
        </div>

        @if (!todoMinimizado)
        {
            <div class="panel-contenido">
                @if (!tareas.Any())
                {
                    <p class="text-white-50 small">No hay tareas pendientes.</p>
                }
                else
                {
                    <div class="todo-list mb-3">
                        @foreach (var tarea in tareas)
                        {
                            <div class="p-2 mb-2 rounded bg-white bg-opacity-10 border border-light border-opacity-10 position-relative todo-item-container">
                                <div class="d-flex align-items-center gap-2 group-actions">
                                    <input type="checkbox" checked="@tarea.IsCompletada" @onchange="() => CambiarEstadoTarea(tarea)" class="form-check-input m-0" />
                                    <span class="flex-grow-1 @(tarea.IsCompletada ? "text-decoration-line-through text-white-50" : "text-white")">@tarea.Titulo</span>
                                    <button class="btn-delete-task" @onclick="() => EliminarTareaPadre(tarea)" title="Eliminar">&#x00D7;</button>
                                </div>

                                @if (tarea.Subtareas != null && tarea.Subtareas.Any())
                                {
                                    <div class="mt-2 ps-4 border-start border-light border-opacity-25">
                                        @foreach (var subtarea in tarea.Subtareas)
                                        {
                                            <div class="d-flex align-items-center gap-2 py-1 group-actions">
                                                <input type="checkbox" checked="@subtarea.IsCompletada" @onchange="() => CambiarEstadoTarea(subtarea)" class="form-check-input m-0" />
                                                <span class="small flex-grow-1 @(subtarea.IsCompletada ? "text-decoration-line-through text-white-50" : "text-white-50")">@subtarea.Titulo</span>
                                                <button class="btn-delete-task" @onclick="() => EliminarSubtarea(tarea, subtarea)" title="Eliminar">&#x00D7;</button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="input-group input-group-sm mt-2 ps-4">
                                    <input type="text" class="form-control bg-dark bg-opacity-25 text-white border-0"
                                           placeholder="Anadir subtarea..."
                                           value="@ObtenerTextoSubtarea(tarea.Id)"
                                           @oninput="@(e => ActualizarTextoSubtarea(tarea.Id, e.Value?.ToString()))"
                                           @onkeyup="@(e => VerificarIntroSubtarea(e, tarea))" />
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorTareas))
                {
                    <p class="text-danger small mb-2">@errorTareas</p>
                }

                <div class="input-group input-group-sm">
                    <input type="text" class="form-control bg-white bg-opacity-10 text-white border-0"
                           placeholder="Nuevo objetivo..."
                           @bind="nuevaTareaTitulo"
                           @onkeyup="HandleKeyUp" />
                    <button class="btn btn-primary" @onclick="CrearNuevaTarea">Agregar</button>
                </div>
            </div>
        }
    </div>

    <!-- PANEL AUDIO -->
    <PanelAudio PosX="audioX"
                PosY="audioY"
                Minimizado="audioMinimizado"
                OnMinimizadoCambiado="v => audioMinimizado = v"
                OnArrastre="OnMouseDownAudio" />

    <!-- PANEL AGENDA -->
    <PanelAgenda @ref="panelAgendaRef"
                 PosX="agendaX"
                 PosY="agendaY"
                 Minimizado="agendaMinimizado"
                 OnMinimizadoCambiado="v => agendaMinimizado = v"
                 OnArrastre="OnMouseDownAgenda"
                 TareasDisponibles="tareas" />

    <!-- PANEL DASHBOARD -->
    <PanelDashboard @ref="panelDashboardRef"
                     PosX="dashboardX"
                     PosY="dashboardY"
                     Minimizado="dashboardMinimizado"
                     OnMinimizadoCambiado="v => dashboardMinimizado = v"
                     OnArrastre="OnMouseDownDashboard" />

    <!-- BARRA IA -->
    <PanelIA OnTareasCreadas="AgregarTareasDesdeIA" OnBloquesCreados="AgregarBloquesDesdeIA" />
}

@code {
    private DotNetObjectReference<Home>? _dotnetRef;

    // Referencia al panel del Dashboard para poder refrescarlo cuando termina un Pomodoro
    // o se marca una tarea, sin depender de que el usuario le dé clic a "Actualizar".
    private PanelDashboard? panelDashboardRef;

    // Referencia al panel de Agenda, para poder refrescarlo cuando la IA agrega bloques nuevos.
    private PanelAgenda? panelAgendaRef;

    // ── Estado paneles ───────────────────────────────────────────
    private bool pomodoroMinimizado = false;
    private bool todoMinimizado = false;
    private bool audioMinimizado = false;
    private bool agendaMinimizado = true;
    private bool dashboardMinimizado = true;

    // Bandera para cancelar apertura/cierre automático si el usuario hizo un arrastre
    private bool huboArrastreReal = false;

    // ── Posiciones ───────────────────────────────────────────────
    private double pomodoroX = 40;
    private double pomodoroY = 120;
    private double todoX = 460;
    private double todoY = 120;
    private double audioX = 40;
    private double audioY = 420;
    private double agendaX = 460;
    private double agendaY = 420;
    private double dashboardX = 40;
    private double dashboardY = 480;

    [JSInvokable]
    public void ActualizarPosicion(string panelId, double x, double y)
    {
        huboArrastreReal = true;
        if (panelId == "panel-pomodoro") { pomodoroX = x; pomodoroY = y; }
        else if (panelId == "panel-todo") { todoX = x; todoY = y; }
        else if (panelId == "panel-audio") { audioX = x; audioY = y; }
        else if (panelId == "panel-agenda") { agendaX = x; agendaY = y; }
        else if (panelId == "panel-dashboard") { dashboardX = x; dashboardY = y; }
        StateHasChanged();
    }

    private async Task OnMouseDownPomodoro(MouseEventArgs e)
    {
        huboArrastreReal = false;
        var offX = pomodoroMinimizado ? 0 : e.ClientX - pomodoroX;
        var offY = e.ClientY - pomodoroY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-pomodoro", _dotnetRef, offX, offY, pomodoroMinimizado);
    }

    private async Task OnMouseDownTodo(MouseEventArgs e)
    {
        huboArrastreReal = false;
        var offX = todoMinimizado ? 0 : e.ClientX - todoX;
        var offY = e.ClientY - todoY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-todo", _dotnetRef, offX, offY, todoMinimizado);
    }

    private async Task OnMouseDownAudio(MouseEventArgs e)
    {
        huboArrastreReal = false;
        var offX = audioMinimizado ? 0 : e.ClientX - audioX;
        var offY = e.ClientY - audioY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-audio", _dotnetRef, offX, offY, audioMinimizado);
    }

    private async Task OnMouseDownAgenda(MouseEventArgs e)
    {
        huboArrastreReal = false;
        var offX = agendaMinimizado ? 0 : e.ClientX - agendaX;
        var offY = e.ClientY - agendaY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-agenda", _dotnetRef, offX, offY, agendaMinimizado);
    }

    private async Task OnMouseDownDashboard(MouseEventArgs e)
    {
        huboArrastreReal = false;
        var offX = dashboardMinimizado ? 0 : e.ClientX - dashboardX;
        var offY = e.ClientY - dashboardY;
        await JS.InvokeVoidAsync("gnosis.iniciarArrastre", "panel-dashboard", _dotnetRef, offX, offY, dashboardMinimizado);
    }

    // ── Callback: tareas creadas por la IA ───────────────────────
    private async Task AgregarTareasDesdeIA(List<TareaModel> tareasNuevas)
    {
        tareas ??= new();
        foreach (var tarea in tareasNuevas)
        {
            tareas.Add(tarea);
            nuevosTitulosSubtareas[tarea.Id] = string.Empty;
            try
            {
                if (TareaProxy != null)
                    await TareaProxy.CrearTareaAsync(tarea);
                if (tarea.Subtareas != null)
                    foreach (var sub in tarea.Subtareas)
                        if (TareaProxy != null)
                            await TareaProxy.CrearTareaAsync(sub);
            }
            catch (Exception ex)
            {
                // No se pudo persistir: la quitamos de la lista local para que no quede
                // "fantasma" (con un Id que no existe en la BD) y pueda romper la Agenda
                // por violación de FK al intentar vincularle un bloque de tiempo.
                Console.WriteLine($"[Gnosis] Error al crear tarea desde IA: {ex.Message}");
                tareas.Remove(tarea);
                nuevosTitulosSubtareas.Remove(tarea.Id);
                errorTareas = "No se pudo guardar una tarea generada por la IA. Verifica tu conexión e inténtalo de nuevo.";
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    // ── Callback: bloques de Agenda creados por la IA ────────────
    private async Task AgregarBloquesDesdeIA(List<BloqueTiempoModel> bloquesNuevos)
    {
        var huboError = false;
        foreach (var bloque in bloquesNuevos)
        {
            try
            {
                await BloqueProxy.CrearAsync(bloque);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Gnosis] Error al crear bloque de agenda desde IA: {ex.Message}");
                huboError = true;
            }
        }

        if (huboError)
            errorTareas = "No se pudo guardar uno o más bloques en la Agenda. Verifica tu conexión e inténtalo de nuevo.";

        // Se expande la Agenda (si estaba minimizada) y se recarga para que los bloques nuevos
        // se vean de inmediato, sin que el usuario tenga que abrirla y refrescarla manualmente.
        agendaMinimizado = false;
        await InvokeAsync(StateHasChanged);
        if (panelAgendaRef != null)
        {
            var primeraFecha = bloquesNuevos.OrderBy(b => b.FechaInicio).Select(b => (DateTime?)b.FechaInicio).FirstOrDefault();
            await panelAgendaRef.RecargarAsync(primeraFecha);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);

            // Solicitar permiso de notificaciones del navegador al cargar la app
            if (Notificaciones != null)
                await Notificaciones.SolicitarPermisoAsync();
        }
    }

    // ── Helpers de panel ─────────────────────────────────────────
    // Al minimizar, el panel se queda a la altura (Y) en la que ya estaba; solo se decide
    // si el borde queda a la izquierda o a la derecha según de qué lado de la pantalla esté.
    private string BordeMinimizado(double x) => x < 700 ? "izquierdo" : "derecho";

    private string EstiloPanel(bool minimizado, double x, double y)
    {
        if (minimizado)
        {
            return x < 700
                ? $"left: 0px; top: {y}px;"
                : $"left: calc(100vw - 72px); top: {y}px;";
        }
        return $"left: {x}px; top: {y}px;";
    }

    private string ModoCorto() => Pomodoro?.ModoActual.ToString() switch
    {
        "Enfoque" => "P",
        "DescansoCorto" => "S",
        "DescansoLargo" => "L",
        _ => "P"
    };

    private void TogglePomodoro()
    {
        if (huboArrastreReal) { huboArrastreReal = false; return; }
        pomodoroMinimizado = !pomodoroMinimizado;
    }

    private void ToggleTodo()
    {
        if (huboArrastreReal) { huboArrastreReal = false; return; }
        todoMinimizado = !todoMinimizado;
    }

    // ── Lógica de tareas ─────────────────────────────────────────
    private List<TareaModel>? tareas;
    private string nuevaTareaTitulo = string.Empty;
    private string? errorTareas;
    private Dictionary<Guid, string> nuevosTitulosSubtareas = new();
    private bool mostrarConfiguracion = false;

    private int TiempoPomodoro
    {
        get => Pomodoro != null ? Pomodoro.DuracionEnfoque : 25;
        set { if (Pomodoro == null) return; Pomodoro.DuracionEnfoque = value; if (Pomodoro.ModoActual == Gnosis.WebUI.ModoPomodoro.Enfoque) Pomodoro.RestablecerTiempoPorModo(); }
    }
    private int TiempoDescansoCorto
    {
        get => Pomodoro != null ? Pomodoro.DuracionDescansoCorto : 5;
        set { if (Pomodoro == null) return; Pomodoro.DuracionDescansoCorto = value; if (Pomodoro.ModoActual == Gnosis.WebUI.ModoPomodoro.DescansoCorto) Pomodoro.RestablecerTiempoPorModo(); }
    }
    private int TiempoDescansoLargo
    {
        get => Pomodoro != null ? Pomodoro.DuracionDescansoLargo : 15;
        set { if (Pomodoro == null) return; Pomodoro.DuracionDescansoLargo = value; if (Pomodoro.ModoActual == Gnosis.WebUI.ModoPomodoro.DescansoLargo) Pomodoro.RestablecerTiempoPorModo(); }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Pomodoro != null)
            {
                Pomodoro.OnTick -= ActualizarPantalla;
                Pomodoro.OnTick += ActualizarPantalla;

                // NUEVO: Suscribirse al fin de sesión para sonido
                Pomodoro.OnSesionTerminada -= OnSesionTerminada;
                Pomodoro.OnSesionTerminada += OnSesionTerminada;
            }
            EstadoFondo.OnCambio -= OnFondoCambiado;
            EstadoFondo.OnCambio += OnFondoCambiado;
            await CargarTareas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Gnosis Error] {ex.Message}");
            tareas = new List<TareaModel>();
        }
    }

    // ── Manejador de fin de sesión (sonido + notificación) ────────
    private async void OnSesionTerminada()
    {
        // Capturar el modo que acaba de terminar ANTES de cualquier await:
        // TemporizadorPomodoro dispara este evento antes de avanzar al siguiente modo.
        var modoTerminado = Pomodoro?.ModoActual;
        var duracionMinutos = modoTerminado switch
        {
            Gnosis.WebUI.ModoPomodoro.Enfoque => Pomodoro?.DuracionEnfoque ?? 0,
            Gnosis.WebUI.ModoPomodoro.DescansoCorto => Pomodoro?.DuracionDescansoCorto ?? 0,
            Gnosis.WebUI.ModoPomodoro.DescansoLargo => Pomodoro?.DuracionDescansoLargo ?? 0,
            _ => 0
        };

        try
        {
            // Reproducir sonido de notificación
            await JS.InvokeVoidAsync("gnosis.reproducirSonido", "notificacion");

            var (titulo, cuerpo) = modoTerminado switch
            {
                Gnosis.WebUI.ModoPomodoro.Enfoque => ("Pomodoro terminado", "Hora de un descanso."),
                Gnosis.WebUI.ModoPomodoro.DescansoCorto => ("Descanso corto terminado", "De vuelta al enfoque."),
                Gnosis.WebUI.ModoPomodoro.DescansoLargo => ("Descanso largo terminado", "De vuelta al enfoque."),
                _ => ("Gnosis", "Sesión terminada.")
            };

            if (Notificaciones != null)
                await Notificaciones.NotificarAsync(titulo, cuerpo);

            // Registrar la sesión completada para el dashboard de productividad.
            // Falla en silencio (no debe interrumpir sonido/notificación si el backend no responde).
            if (SesionProxy != null && modoTerminado.HasValue)
            {
                try
                {
                    await SesionProxy.RegistrarSesionAsync(modoTerminado.Value.ToString(), duracionMinutos);
                    // La sesión ya quedó guardada: refrescamos el Dashboard para que la racha,
                    // los minutos de enfoque y el total de sesiones se vean al día sin recargar la página.
                    if (panelDashboardRef != null) await panelDashboardRef.RecargarAsync();
                }
                catch (Exception exSesion)
                {
                    Console.WriteLine($"[Gnosis] Error al registrar sesión: {exSesion.Message}");
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Gnosis] Error al notificar fin de sesión: {ex.Message}");
        }
    }

    private string ObtenerUrlEmbed()
    {
        var videoId = EstadoFondo.FondoActivo.YoutubeVideoId;
        var origen = NavManager.BaseUri.TrimEnd('/');
        return $"https://www.youtube.com/embed/{videoId}?autoplay=1&mute=1&loop=1&playlist={videoId}&controls=0&showinfo=0&rel=0&iv_load_policy=3&disablekb=1&modestbranding=1&enablejsapi=1&playsinline=1&origin={origen}";
    }

    // Al cambiar de fondo, el <iframe> de YouTube cambia de "src" y recarga desde cero —
    // durante ese instante puede alcanzar a mostrarse brevemente su UI nativa (controles de
    // pausa/siguiente) antes de que el autoplay arranque. Tapamos la pantalla con el overlay
    // oscuro mientras tanto, y lo destapamos cuando el nuevo video ya debería estar reproduciendo.
    private bool ocultandoTransicionFondo = false;

    private async void OnFondoCambiado()
    {
        ocultandoTransicionFondo = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1200);
        ocultandoTransicionFondo = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleConfiguracion() => mostrarConfiguracion = !mostrarConfiguracion;

    private async Task CerrarSesionAsync()
    {
        await TokenStorage.BorrarTokenAsync();
        if (AuthStateProvider is Gnosis.WebUI.services.JwtAuthenticationStateProvider proveedor)
            proveedor.NotificarCambioDeSesion();
        NavManager.NavigateTo("/login", forceLoad: true);
    }

    private async Task CargarTareas()
    {
        try { tareas = TareaProxy != null ? (await TareaProxy.ObtenerTodasAsync())?.ToList() ?? new() : new(); }
        catch (Exception ex) { Console.WriteLine($"Error al cargar tareas: {ex.Message}"); tareas = new(); }
        nuevosTitulosSubtareas = new();
        if (tareas != null)
            foreach (var t in tareas)
                if (t != null && !nuevosTitulosSubtareas.ContainsKey(t.Id))
                    nuevosTitulosSubtareas[t.Id] = string.Empty;
    }

    private string ObtenerTextoSubtarea(Guid id) => nuevosTitulosSubtareas.TryGetValue(id, out var texto) ? texto : string.Empty;
    private void ActualizarTextoSubtarea(Guid id, string? valor) => nuevosTitulosSubtareas[id] = valor ?? string.Empty;

    private async Task CrearNuevaTarea()
    {
        if (string.IsNullOrWhiteSpace(nuevaTareaTitulo)) return;
        var nueva = new TareaModel { Id = Guid.NewGuid(), Titulo = nuevaTareaTitulo, FechaCreacion = DateTime.UtcNow, Subtareas = new() };
        tareas ??= new();
        tareas.Add(nueva);
        nuevosTitulosSubtareas[nueva.Id] = string.Empty;
        nuevaTareaTitulo = string.Empty;
        errorTareas = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (TareaProxy != null) await TareaProxy.CrearTareaAsync(nueva);
        }
        catch (Exception ex)
        {
            // El guardado en el servidor falló: revertimos el agregado optimista.
            // Si la dejáramos en la lista, su Id nunca existiría en la BD y cualquier
            // bloque de Agenda vinculado a ella dispararía una violación de FK al guardarse.
            Console.WriteLine($"[Gnosis] Error al crear tarea: {ex.Message}");
            tareas.Remove(nueva);
            nuevosTitulosSubtareas.Remove(nueva.Id);
            errorTareas = "No se pudo guardar la tarea. Verifica tu conexión e inténtalo de nuevo.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AgregarSubtarea(TareaModel padre)
    {
        if (!nuevosTitulosSubtareas.TryGetValue(padre.Id, out var sub) || string.IsNullOrWhiteSpace(sub)) return;
        var nuevaSub = new TareaModel { Id = Guid.NewGuid(), Titulo = sub, TareaPadreId = padre.Id, Subtareas = new() };
        padre.Subtareas ??= new();
        padre.Subtareas.Add(nuevaSub);
        nuevosTitulosSubtareas[padre.Id] = string.Empty;
        errorTareas = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (TareaProxy != null) await TareaProxy.CrearTareaAsync(nuevaSub);
        }
        catch (Exception ex)
        {
            // Mismo motivo que en CrearNuevaTarea: sin esto, una subtarea "fantasma"
            // podría vincularse a un bloque de Agenda y romper el insert por FK.
            Console.WriteLine($"[Gnosis] Error al agregar subtarea: {ex.Message}");
            padre.Subtareas.Remove(nuevaSub);
            nuevosTitulosSubtareas.Remove(padre.Id);
            errorTareas = "No se pudo guardar la subtarea. Verifica tu conexión e inténtalo de nuevo.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CambiarEstadoTarea(TareaModel tarea)
    {
        tarea.IsCompletada = !tarea.IsCompletada;
        try
        {
            if (TareaProxy != null) await TareaProxy.ActualizarEstadoTareaAsync(tarea.Id, tarea.IsCompletada);
            // Completar/descompletar una tarea cambia el conteo de "tareas completadas" del Dashboard.
            if (panelDashboardRef != null) await panelDashboardRef.RecargarAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Gnosis] Error al actualizar estado de tarea: {ex.Message}");
        }
    }

    private async Task EliminarTareaPadre(TareaModel padre)
    {
        if (tareas == null) return;
        tareas.Remove(padre);
        if (nuevosTitulosSubtareas.ContainsKey(padre.Id)) nuevosTitulosSubtareas.Remove(padre.Id);
        if (TareaProxy != null)
            try { await TareaProxy.EliminarTareaAsync(padre.Id); }
            catch (Exception ex) { Console.WriteLine($"Error al eliminar: {ex.Message}"); }
    }

    private async Task EliminarSubtarea(TareaModel padre, TareaModel subtarea)
    {
        padre.Subtareas?.Remove(subtarea);
        if (TareaProxy != null)
            try { await TareaProxy.EliminarTareaAsync(subtarea.Id); }
            catch (Exception ex) { Console.WriteLine($"Error al eliminar subtarea: {ex.Message}"); }
    }

    private async Task VerificarIntroSubtarea(KeyboardEventArgs e, TareaModel padre) { if (e.Key == "Enter") await AgregarSubtarea(padre); }
    private async Task HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await CrearNuevaTarea(); }
    private void ActualizarPantalla() => InvokeAsync(StateHasChanged);
    private void SeleccionarModo(Gnosis.WebUI.ModoPomodoro modo) { Pomodoro?.CambiarModo(modo); StateHasChanged(); }

    public void Dispose()
    {
        if (Pomodoro != null)
        {
            Pomodoro.OnTick -= ActualizarPantalla;
            Pomodoro.OnSesionTerminada -= OnSesionTerminada;
        }
        EstadoFondo.OnCambio -= OnFondoCambiado;
        _dotnetRef?.Dispose();
    }
}