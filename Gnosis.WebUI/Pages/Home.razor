@page "/"

<PageTitle>Gnosis - Entorno de Enfoque</PageTitle>

<div class="gnosis-container">
    <header class="zen-header">
        <h1>GNOSIS</h1>
        <p class="tagline">Optimiza tu aprendizaje autónomo en un espacio libre de distracciones.</p>
    </header>

    <div class="workspace-grid">
        <section class="focus-card">
            <div class="card-header">
                <h2><i class="oi oi-timer"></i> Sesión de Enfoque</h2>
            </div>
            <div class="timer-display">
                <span class="time-digits">@TiempoFormateado</span>
                <span class="timer-status">@EstadoSesion</span>
            </div>
            <div class="timer-actions">
                @if (!isTimerRunning)
                {
                    <button class="btn btn-primary" @onclick="IniciarTimer">Iniciar Enfoque</button>
                }
                else
                {
                    <button class="btn btn-warning" @onclick="PausarTimer">Pausar</button>
                }
                <button class="btn btn-secondary" @onclick="ReiniciarTimer">Reiniciar</button>
            </div>
        </section>

        <section class="tasks-card">
            <div class="card-header">
                <h2><i class="oi oi-list"></i> Objetivos de Aprendizaje</h2>
            </div>

            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="¿Qué vas a aprender u optimizar hoy?..." @bind="nuevaTareaTitulo" />
                <button class="btn btn-success" @onclick="AgregarTareaPrincipal">Agregar Objetivo</button>
            </div>

            <div class="tasks-wrapper">
                @foreach (var tarea in TareasSimuladas)
                {
                    <div class="task-item-main">
                        <div class="task-main-content">
                            <input type="checkbox" @bind="tarea.IsCompleted" />
                            <span class="task-title @(tarea.IsCompleted ? "completed" : "")">@tarea.Titulo</span>
                        </div>

                        <div class="subtasks-list">
                            @foreach (var sub in tarea.Subtareas)
                            {
                                <div class="subtask-item">
                                    <input type="checkbox" @bind="sub.IsCompleted" />
                                    <span class="subtask-title @(sub.IsCompleted ? "completed" : "")">@sub.Titulo</span>
                                </div>
                            }
                            <div class="input-group input-group-sm mt-2 ps-4">
                                <input type="text" class="form-control" placeholder="Desglosar este objetivo..." @bind="tarea.NuevaSubtareaTitulo" />
                                <button class="btn btn-outline-secondary" @onclick="() => AgregarSubtarea(tarea)">+</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<style>
    :root {
        --bg-zen: #f8fafc;
        --text-main: #0f172a;
        --accent-blue: #005088;
        --border-color: #e2e8f0;
    }

    .gnosis-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .zen-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .zen-header h1 {
        font-size: 2.5rem;
        letter-spacing: 4px;
        color: var(--accent-blue);
        margin: 0;
        font-weight: 700;
    }

    .tagline {
        color: #64748b;
        font-size: 1.1rem;
        margin-top: 8px;
    }

    .workspace-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 30px;
    }

    .focus-card, .tasks-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
    }

    .card-header h2 {
        font-size: 1.3rem;
        color: var(--text-main);
        margin: 0 0 20px 0;
        font-weight: 600;
    }

    /* ESTILOS TIMER */
    .timer-display {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 40px 0;
    }

    .time-digits {
        font-size: 4.5rem;
        font-weight: 700;
        color: var(--text-main);
        font-variant-numeric: tabular-nums;
    }

    .timer-status {
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.9rem;
        margin-top: 10px;
    }

    .timer-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    /* ESTILOS TAREAS */
    .tasks-wrapper {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 20px;
    }

    .task-item-main {
        border-left: 3px solid var(--accent-blue);
        padding-left: 15px;
        margin-bottom: 10px;
    }

    .task-main-content {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
        font-weight: 500;
    }

    .subtasks-list {
        margin-top: 10px;
        padding-left: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .subtask-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        color: #475569;
    }

    .completed {
        text-decoration: line-through;
        color: #94a3b8;
    }
</style>

@code {
    // --- LÓGICA DE TIMER SIMULADO ---
    private string TiempoFormateado = "25:00";
    private string EstadoSesion = "Listo para concentrarse";
    private bool isTimerRunning = false;

    private void IniciarTimer()
    {
        isTimerRunning = true;
        EstadoSesion = "Bloque de Enfoque Activo";
        TiempoFormateado = "24:59"; // Simulación visual inicial
    }

    private void PausarTimer()
    {
        isTimerRunning = false;
        EstadoSesion = "En Pausa";
    }

    private void ReiniciarTimer()
    {
        isTimerRunning = false;
        EstadoSesion = "Listo para concentrarse";
        TiempoFormateado = "25:00";
    }

    // --- LÓGICA DE TAREAS SIMULADAS ---
    private string nuevaTareaTitulo = "";

    public class TareaVistaSimulada
    {
        public string Titulo { get; set; } = "";
        public bool IsCompleted { get; set; }
        public List<SubtareaVistaSimulada> Subtareas { get; set; } = new();
        public string NuevaSubtareaTitulo { get; set; } = "";
    }

    public class SubtareaVistaSimulada
    {
        public string Titulo { get; set; } = "";
        public bool IsCompleted { get; set; }
    }

    private List<TareaVistaSimulada> TareasSimuladas = new()
    {
        new TareaVistaSimulada
        {
            Titulo = "Diseño Conceptual de Gnosis",
            Subtareas = new() {
                new SubtareaVistaSimulada { Titulo = "Estructurar ADR-02 para N-Layer", IsCompleted = true },
                new SubtareaVistaSimulada { Titulo = "Definir agregados del dominio", IsCompleted = false }
            }
        }
    };

    private void AgregarTareaPrincipal()
    {
        if (!string.IsNullOrWhiteSpace(nuevaTareaTitulo))
        {
            TareasSimuladas.Add(new TareaVistaSimulada { Titulo = nuevaTareaTitulo });
            nuevaTareaTitulo = "";
        }
    }

    private void AgregarSubtarea(TareaVistaSimulada tareaPadre)
    {
        if (!string.IsNullOrWhiteSpace(tareaPadre.NuevaSubtareaTitulo))
        {
            tareaPadre.Subtareas.Add(new SubtareaVistaSimulada { Titulo = tareaPadre.NuevaSubtareaTitulo });
            tareaPadre.NuevaSubtareaTitulo = "";
        }
    }
}