@page "/"
@inject Gnosis.WebUI.TemporizadorPomodoro Pomodoro
@inject Gnosis.WebUI.ITareaHttpProxy TareaProxy
@using Gnosis.Business.Models
@implements IDisposable

<div class="workspace-container">

    <!-- SECCIÓN SUPERIOR: TEMPORIZADOR ALINEADO A LA IZQUIERDA -->
    <div class="timer-block">
        <div class="status-sub text-muted mb-1">
            @Pomodoro.ModoActual.ToString() - @Pomodoro.NombreEstadoActual
        </div>

        <div class="timer-clock mb-2">@Pomodoro.TiempoFormateado</div>

        <div class="btn-group btn-group-sm mb-3" role="group">
            <button class="btn btn-outline-secondary" @onclick="() => Pomodoro.CambiarModo(ModoPomodoro.Enfoque)">Enfoque</button>
            <button class="btn btn-outline-secondary" @onclick="() => Pomodoro.CambiarModo(ModoPomodoro.DescansoCorto)">Corto</button>
            <button class="btn btn-outline-secondary" @onclick="() => Pomodoro.CambiarModo(ModoPomodoro.DescansoLargo)">Largo</button>
        </div>

        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-success btn-action" @onclick="Pomodoro.Iniciar">Iniciar</button>
            <button class="btn btn-sm btn-warning btn-action text-white" @onclick="Pomodoro.Pausar">Pausar</button>
            <button class="btn btn-sm btn-light btn-action border" @onclick="Pomodoro.Detener">Reiniciar</button>
        </div>
    </div>

    <!-- SECCIÓN INFERIOR: LISTA TO-DO CON SUBTAREAS -->
    <div class="todo-block">
        <h6 class="todo-title mb-3 pb-1 border-bottom">Lista To-Do</h6>

        @if (tareas == null)
        {
            <span class="text-light-muted small">Cargando objetivos...</span>
        }
        else if (!tareas.Any())
        {
            <p class="no-tasks-msg small m-0">No hay tareas pendientes en esta sesión.</p>
        }
        else
        {
            <div class="todo-list mb-3">
                @foreach (var tarea in tareas)
                {
                    <div class="p-2 mb-2 border border-secondary rounded bg-dark">
                        <!-- TAREA PRINCIPAL -->
                        <div class="d-flex justify-content-between align-items-center task-item mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <input type="checkbox"
                                       checked="@tarea.IsCompletada"
                                       @onchange="() => CambiarEstadoTarea(tarea)"
                                       class="form-check-input m-0 cursor-pointer" />
                                <span class="task-title @(tarea.IsCompletada ? "text-decoration-line-through text-muted" : "text-white")">
                                    @tarea.Titulo
                                </span>
                                @if (!string.IsNullOrEmpty(tarea.Descripcion))
                                {
                                    <span class="task-desc small text-muted"> — @tarea.Descripcion</span>
                                }
                            </div>
                        </div>

                        <!-- LISTA DE SUBTAREAS -->
                        @if (tarea.Subtareas != null && tarea.Subtareas.Any())
                        {
                            <div class="mt-2 ps-4 border-start border-secondary">
                                @foreach (var subtarea in tarea.Subtareas)
                                {
                                    <div class="d-flex align-items-center gap-2 py-1">
                                        <input type="checkbox"
                                               checked="@subtarea.IsCompletada"
                                               @onchange="() => CambiarEstadoTarea(subtarea)"
                                               class="form-check-input m-0 cursor-pointer" />
                                        <span class="small @(subtarea.IsCompletada ? "text-decoration-line-through text-muted" : "text-light")">
                                            @subtarea.Titulo
                                        </span>
                                    </div>
                                }
                            </div>
                        }

                        <!-- FORMULARIO PARA AÑADIR SUBTAREA -->
                        <div class="input-group input-group-sm mt-2 ps-4">
                            <input type="text" class="form-control bg-dark text-white border-secondary text-xs"
                                   placeholder="Añadir subtarea..."
                                   @bind="NuevosTitulosSubtareas[tarea.Id]"
                                   @onkeyup="@(e => VerificarIntroSubtarea(e, tarea))" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => AgregarSubtarea(tarea)">+</button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- FORMULARIO PARA AGREGAR TAREAS PRINCIPALES -->
        <div class="input-group input-group-sm mt-3">
            <input type="text" class="form-control bg-dark text-white border-secondary"
                   placeholder="Nuevo objetivo principal..." @bind="nuevaTareaTitulo" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button class="btn btn-primary" type="button" @onclick="CrearNuevaTarea">Agregar</button>
        </div>
    </div>
</div>

@code {
    private List<TareaModel>? tareas;
    private string nuevaTareaTitulo = string.Empty;

    // Diccionario para manejar el texto de la subtarea por cada Id de tarea principal
    private Dictionary<Guid, string> NuevosTitulosSubtareas { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Pomodoro.OnTick += ActualizarPantalla;
        await CargarTareas();
    }

    private async Task CargarTareas()
    {
        try
        {
            var resultado = await TareaProxy.ObtenerTodasAsync();
            tareas = resultado?.ToList() ?? new List<TareaModel>();

            // Inicializar el diccionario para evitar excepciones de clave no encontrada
            NuevosTitulosSubtareas = tareas.ToDictionary(t => t.Id, t => string.Empty);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar tareas de la API: {ex.Message}");
            tareas = new List<TareaModel>();
        }
    }

    private async Task CrearNuevaTarea()
    {
        var tituloLimpio = nuevaTareaTitulo?.Trim();

        if (string.IsNullOrWhiteSpace(tituloLimpio))
        {
            Console.WriteLine("El título está vacío, ignorando creación.");
            return;
        }

        var nueva = new TareaModel
        {
            Id = Guid.NewGuid(),
            Titulo = tituloLimpio,
            IsCompletada = false,
            FechaCreacion = DateTime.UtcNow
        };

        try
        {
            nuevaTareaTitulo = string.Empty;
            tareas ??= new List<TareaModel>();

            tareas.Add(nueva);
            NuevosTitulosSubtareas[nueva.Id] = string.Empty;
            StateHasChanged();

            await TareaProxy.CrearTareaAsync(nueva);
            Console.WriteLine("Tarea guardada exitosamente en el backend.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico al persistir la tarea en la API: {ex.Message}");
            await CargarTareas();
            StateHasChanged();
        }
    }

    private async Task AgregarSubtarea(TareaModel padre)
    {
        if (!NuevosTitulosSubtareas.TryGetValue(padre.Id, out var tituloSubtarea) || string.IsNullOrWhiteSpace(tituloSubtarea))
            return;

        var subLimpio = tituloSubtarea.Trim();

        var nuevaSubtarea = new TareaModel
        {
            Id = Guid.NewGuid(),
            Titulo = subLimpio,
            IsCompletada = false,
            FechaCreacion = DateTime.UtcNow,
            TareaPadreId = padre.Id
        };

        try
        {
            // Limpieza visual inmediata
            NuevosTitulosSubtareas[padre.Id] = string.Empty;

            padre.Subtareas ??= new List<TareaModel>();
            padre.Subtareas.Add(nuevaSubtarea);
            StateHasChanged();

            // Enviamos la subtarea a la API a través de tu proxy (usa el método que crees para subtareas o el general si soporta herencia)
            await TareaProxy.CrearTareaAsync(nuevaSubtarea);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar subtarea: {ex.Message}");
            await CargarTareas();
            StateHasChanged();
        }
    }

    private async Task CambiarEstadoTarea(TareaModel tarea)
    {
        tarea.IsCompletada = !tarea.IsCompletada;
        StateHasChanged();

        try
        {
            // Envía la actualización a la API usando tu proxy existente
            await TareaProxy.ActualizarEstadoTareaAsync(tarea.Id, tarea.IsCompletada);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cambiar estado de la tarea: {ex.Message}");
            // Si el backend falla, revertimos el estado localmente
            tarea.IsCompletada = !tarea.IsCompletada;
            StateHasChanged();
        }
    }

    private async Task VerificarIntroSubtarea(KeyboardEventArgs e, TareaModel padre)
    {
        if (e.Key == "Enter")
        {
            await AgregarSubtarea(padre);
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CrearNuevaTarea();
        }
    }

    private void ActualizarPantalla()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Pomodoro.OnTick -= ActualizarPantalla;
    }
}