@page "/restablecer-password"
@inject IAuthHttpProxy AuthProxy
@inject NavigationManager NavManager

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-titulo">Gnosis</h1>

        @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <p class="text-danger small">Enlace inválido. Pide uno nuevo desde "¿Olvidaste tu contraseña?".</p>
            <p class="auth-link">
                <a href="/olvide-password">Pedir enlace nuevo</a>
            </p>
        }
        else if (completado)
        {
            <p class="text-success small">@mensaje</p>
            <a class="btn btn-primary auth-btn" href="/login">Ir a iniciar sesión</a>
        }
        else
        {
            <p class="auth-subtitulo">Elige tu contraseña nueva para @Email.</p>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="text-danger small">@error</p>
            }

            <div class="auth-campo">
                <label>Contraseña nueva</label>
                <input type="password" class="form-control" @bind="password" disabled="@cargando" />
                <span class="auth-hint">Mínimo 6 caracteres, con mayúscula, minúscula y número.</span>
            </div>

            <div class="auth-campo">
                <label>Confirmar contraseña</label>
                <input type="password" class="form-control" @bind="confirmarPassword" @onkeyup="HandleKeyUp" disabled="@cargando" />
            </div>

            <button class="btn btn-primary auth-btn" @onclick="RestablecerAsync" disabled="@cargando">
                @(cargando ? "Guardando..." : "Guardar contraseña")
            </button>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    [Parameter]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    [Parameter]
    public string? Token { get; set; }

    private string password = string.Empty;
    private string confirmarPassword = string.Empty;
    private string? error;
    private string? mensaje;
    private bool cargando;
    private bool completado;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RestablecerAsync();
    }

    private async Task RestablecerAsync()
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            error = "Escribe la contraseña nueva.";
            return;
        }

        if (password != confirmarPassword)
        {
            error = "Las contraseñas no coinciden.";
            return;
        }

        cargando = true;
        error = null;
        var resultado = await AuthProxy.RestablecerPasswordAsync(Email!, Token!, password);
        cargando = false;

        if (!resultado.Exito)
        {
            error = resultado.Mensaje ?? "No se pudo restablecer la contraseña.";
            return;
        }

        completado = true;
        mensaje = resultado.Mensaje ?? "Contraseña actualizada. Ya puedes iniciar sesión.";
    }
}
