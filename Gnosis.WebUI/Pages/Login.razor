@page "/login"
@inject IAuthHttpProxy AuthProxy
@inject Gnosis.WebUI.services.TokenStorageService TokenStorage
@inject NavigationManager NavManager
@using Microsoft.AspNetCore.Components.Authorization

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-titulo">Gnosis</h1>
        <p class="auth-subtitulo">Inicia sesión para ver tus tareas, agenda y estadísticas.</p>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <p class="text-success small">@mensajeExito</p>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="text-danger small">@error</p>
        }

        @if (mostrarReenviarConfirmacion)
        {
            <p class="auth-hint">
                <a href="#" @onclick="ReenviarConfirmacionAsync" @onclick:preventDefault>
                    @(reenviando ? "Enviando..." : "Reenviar correo de confirmación")
                </a>
            </p>
        }

        <div class="auth-campo">
            <label>Correo</label>
            <input type="email" class="form-control" @bind="email" @onkeyup="HandleKeyUp" disabled="@cargando" />
        </div>

        <div class="auth-campo">
            <label>Contraseña</label>
            <input type="password" class="form-control" @bind="password" @onkeyup="HandleKeyUp" disabled="@cargando" />
        </div>

        <button class="btn btn-primary auth-btn" @onclick="EntrarAsync" disabled="@cargando">
            @(cargando ? "Entrando..." : "Entrar")
        </button>

        <button class="btn btn-outline-secondary auth-btn" @onclick="EntrarComoInvitadoAsync" disabled="@cargando">
            @(cargandoInvitado ? "Entrando..." : "Continuar como invitado")
        </button>
        <p class="auth-hint">
            Modo invitado: pruebas la app sin registrarte, pero no vas a poder volver a esta misma
            sesión después — para guardar tus datos a largo plazo, crea una cuenta.
        </p>

        <p class="auth-link">
            <a href="/olvide-password">¿Olvidaste tu contraseña?</a>
        </p>
        <p class="auth-link">
            ¿No tienes cuenta? <a href="/registro">Regístrate</a>
        </p>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? error;
    private string? mensajeExito;
    private bool cargando;
    private bool cargandoInvitado;
    private bool mostrarReenviarConfirmacion;
    private bool reenviando;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await EntrarAsync();
    }

    private async Task EntrarAsync()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Ingresa tu correo y tu contraseña.";
            return;
        }

        cargando = true;
        error = null;
        mensajeExito = null;
        mostrarReenviarConfirmacion = false;
        var resultado = await AuthProxy.LoginAsync(email.Trim(), password);
        cargando = false;

        if (!resultado.Exito || string.IsNullOrEmpty(resultado.Token))
        {
            error = resultado.Error ?? "Correo o contraseña incorrectos.";
            mostrarReenviarConfirmacion = resultado.NoConfirmado;
            return;
        }

        await CompletarSesionAsync(resultado.Token);
    }

    private async Task EntrarComoInvitadoAsync()
    {
        cargandoInvitado = true;
        error = null;
        mensajeExito = null;
        mostrarReenviarConfirmacion = false;
        var resultado = await AuthProxy.EntrarComoInvitadoAsync();
        cargandoInvitado = false;

        if (!resultado.Exito || string.IsNullOrEmpty(resultado.Token))
        {
            error = resultado.Error ?? "No se pudo entrar como invitado.";
            return;
        }

        await CompletarSesionAsync(resultado.Token);
    }

    private async Task CompletarSesionAsync(string token)
    {
        await TokenStorage.GuardarTokenAsync(token);

        if (AuthStateProvider is Gnosis.WebUI.services.JwtAuthenticationStateProvider proveedor)
            proveedor.NotificarCambioDeSesion();

        NavManager.NavigateTo("/", forceLoad: false);
    }

    private async Task ReenviarConfirmacionAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Escribe tu correo arriba primero.";
            return;
        }

        reenviando = true;
        var resultado = await AuthProxy.ReenviarConfirmacionAsync(email.Trim());
        reenviando = false;

        mensajeExito = resultado.Mensaje;
        error = null;
        mostrarReenviarConfirmacion = false;
    }

    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
}
