<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirigirALogin />
                </NotAuthorized>
                <Authorizing>
                    @* Mismo aro/halo que la pantalla de carga inicial (index.html), para que se sienta
                       como una sola animación continua en vez de un salto a un cuadro de texto plano. *@
                    <div class="pantalla-carga">
                        <svg class="loading-progress">
                            <circle r="40%" cx="50%" cy="50%" />
                            <circle r="40%" cx="50%" cy="50%" />
                        </svg>
                        <div class="loading-progress-text"></div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Lo siento, no hay nada en esta dirección.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
